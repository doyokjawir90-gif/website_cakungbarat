# Salin menjadi .env lalu isi. JANGAN bagikan atau unggah file .env.

# Akun admin awal (hanya dipakai saat pertama kali dijalankan, bila belum ada akun).
# Jika dikosongkan, password acak dibuat dan ditulis ke data/AKUN_ADMIN_AWAL.txt
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Wajib "1" bila website diakses lewat HTTPS (sangat disarankan untuk produksi)
COOKIE_SECURE=1

# Isi "1" bila berjalan di belakang Nginx/reverse proxy (agar IP pengunjung terbaca benar)
BEHIND_PROXY=1

# Lokasi penyimpanan database & file unggahan (default: folder ./data)
# DATA_DIR=/var/lib/cakung-barat

# Kunci sesi. Kosongkan agar dibuat otomatis dan disimpan di DATA_DIR/secret.key
# SECRET_KEY=
